# LIFF
VITE_LIFF_ID=

# Neon PostgreSQL（Vercel の Neon 連携で自動設定）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 管理者の LINE userId（カンマ区切り）。未設定なら管理画面は誰も使えない
ADMIN_LINE_USER_IDS=

# Stripe決済
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# RemoteLock スマートロック連携
# OAuthアプリ認証情報
REMOTELOCK_CLIENT_ID=
REMOTELOCK_CLIENT_SECRET=
# デバイスID（RemoteLock APIのデバイスID、シリアル番号ではない）
# ASP玄関扉 (共用入口) - シリアル: AC000W017827101
REMOTELOCK_DEVICE_ID_ENTRANCE=
# ASP体育館 - シリアル: AC000W017830299
REMOTELOCK_DEVICE_ID_GYM=
# ASPトレーニングルーム - シリアル: AC000W017830548
REMOTELOCK_DEVICE_ID_TRAINING=
# みんなの体育館八橋（やばせ） - シリアル: AC000W017827205
REMOTELOCK_DEVICE_ID_YABASE=

# App URL (Vercelデプロイ後に設定)
VITE_APP_URL=https://your-app.vercel.app

# 開発用: 決済スキップ（true で Stripe をスキップ）。本番では必ず false または未設定
# SKIP_PAYMENT=true
# 開発用: RemoteLock 登録スキップ
# SKIP_REMOTELOCK=true

# 予約/キャンセルの LINE 通知（Messaging API 長期トークン）
LINE_CHANNEL_ACCESS_TOKEN=
# 領収書メール（Resend）
RESEND_API_KEY=
RECEIPT_EMAIL_FROM="みんなの体育館 <mintai@lpower.jp>"
# 予約開始の何分前からPINを有効にするか（既定10）
REMOTELOCK_START_MARGIN_MIN=10
